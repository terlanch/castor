# 复制为 .env 后填写。勿提交 .env。
# CASTOR_BASE_URL=http://localhost:8080
# CASTOR_ADMIN_TOKEN=castor-admin
# CASTOR_LLM_API_KEY=
# ARK_API_KEY=
# CASTOR_LLM_BASE_URL=https://api.openai.com/v1
# CASTOR_LLM_MODEL=gpt-4o-mini
# CASTOR_LLM_JSON_OBJECT_MODE=1
# CASTOR_DB_PATH=data/castor.db
# CASTOR_HEARTBEAT_TIMEOUT_SECONDS=7200
#
# Google OAuth (user login — set both; redirect URI in Google Console must match)
# CASTOR_GOOGLE_CLIENT_ID=
# CASTOR_GOOGLE_CLIENT_SECRET=
# Optional: CASTOR_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/users/auth/google/callback
# Optional: CASTOR_GOOGLE_OAUTH_STATE_SECRET=random-long-string
